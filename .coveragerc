[run]
source = api, services, database, core
omit =
    */tests/*
    */test_*.py
    */desktop.py
    */gui.py
    */email_sender/*
    */visualiser_db.py
    */main.py
    */scheduler_task.py
    */diagnostic.py
    */debug_types.py
    */migrer_etages.py
    */reclassifier_etages.py
    */show_data.py
    */compter_produits_par_lot.py
    */voir_oree_cedre.py
    */test_backend.py
    */a_*.py
    */__pycache__/*
    */.pytest_cache/*
    */mubawab_scraper_single.py
    */avito.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    if False:
    if TYPE_CHECKING:
    @abstractmethod
    def __repr__
    def __str__
    def __len__
    def __iter__

precision = 2